APP_ENV=local
DEBUG=false
DJANGO_SECRET_KEY=local-only-development-secret-change-before-deploy
JWT_SECRET=local-only-development-jwt-secret-change-before-deploy
DATABASE_URL=postgres://gyma:gyma@localhost:55432/gyma_django
ALLOWED_HOSTS=localhost,127.0.0.1
HTTP_PORT=8080
HTTP_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8080
PUBLIC_BASE_URL=http://localhost:8080
MEMBER_PHOTO_DIR=./data/member-photos
LOG_LEVEL=INFO
OTP_DEV_BYPASS=true
EMAIL_DEV_BYPASS=true
OTP_DEV_MASTER_CODE=000000
OTP_TTL_SEC=300
OTP_RESEND_SEC=24
JWT_ACCESS_TTL_SEC=3600
JWT_REFRESH_TTL_SEC=2592000
MFA_SETUP_TTL_SEC=1800
GOOGLE_LINK_TTL_SEC=1800
TOTP_ISSUER=Titanic Gym
# Generate a private 32-byte raw, hex, or base64 key before MFA setup.
TOTP_ENCRYPTION_KEY=
FIREBASE_CREDENTIALS_FILE=
SMS_NET_BD_API_KEY=
SMS_NET_BD_SENDER_ID=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWD=
SSLCOMMERZ_SANDBOX=true
# Set a private device key before using check-in ingestion.
ATTENDANCE_DEVICE_KEY=
POSTGRES_USER=gyma
POSTGRES_PASSWORD=gyma
POSTGRES_DB=gyma_django
POSTGRES_PORT=55432
# Exact proxy IPs allowed to supply X-Forwarded-For; empty ignores that header.
TRUSTED_PROXY_IPS=
