APP_ENV=local
DEBUG=false
DJANGO_SECRET_KEY=local-only-development-secret-change-before-deploy
JWT_SECRET=local-only-development-jwt-secret-change-before-deploy
# Standalone API: Postgres must already be running in Docker (not started by this compose).
# Create a dedicated empty DB: CREATE DATABASE gyma_django;
# Compose container → host Postgres: host.docker.internal
# Host Python (uv/make run) → localhost and the published port.
DATABASE_URL=postgres://gyma:CHANGE_ME@host.docker.internal:5432/gyma_django
# API hostnames accepted from the mobile app, local tools, and the web frontend.
ALLOWED_HOSTS=localhost,127.0.0.1,puregym.fit
HTTP_PORT=8080
# Browser origins include the scheme and port; native mobile apps do not use CORS.
HTTP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080,https://puregym.fit
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080,https://puregym.fit
# Set to https://puregym.fit when deployed (one canonical public API origin).
PUBLIC_BASE_URL=http://localhost:8080
# Optional browser checkout handoff; leave blank to retain backend return pages.
# Set to https://puregym.fit when the frontend is deployed there.
WEB_APP_BASE_URL=http://localhost:3000
# On a physical phone, localhost/127.0.0.1 refer to the phone itself.
# Use puregym.fit or your computer's LAN IP; add that IP to ALLOWED_HOSTS if needed.
# Local standalone: filesystem. Production/dev server: s3 (MinIO or AWS).
MEDIA_STORAGE=filesystem
AWS_STORAGE_BUCKET_NAME=gyma-media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# MinIO API URL (not console); hostname/IP must work for backend AND clients.
# Replace with your host's LAN IP or a hostname reachable from both.
AWS_S3_ENDPOINT_URL=http://YOUR_HOST_LAN_IP:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ADDRESSING_STYLE=path
# This project's folder inside the shared bucket; nested paths are supported.
# Files use S3_SUB_FOLDER/AWS_LOCATION/<filename>, e.g. puregym/media/<filename>.
S3_SUB_FOLDER=puregym
AWS_LOCATION=media
AWS_QUERYSTRING_EXPIRE=3600
# For AWS: clear AWS_S3_ENDPOINT_URL, set the bucket region and addressing=virtual.
# Credentials may be blank when using an AWS IAM role.
# Only used with MEDIA_STORAGE=filesystem (tests or standalone development).
MEMBER_PHOTO_DIR=./data/member-photos
LOG_LEVEL=INFO
OTP_DEV_BYPASS=true
EMAIL_DEV_BYPASS=true
OTP_DEV_MASTER_CODE=000000
OTP_TTL_SEC=300
OTP_RESEND_SEC=24
JWT_ACCESS_TTL_SEC=3600
JWT_REFRESH_TTL_SEC=2592000
MFA_SETUP_TTL_SEC=1800
GOOGLE_LINK_TTL_SEC=1800
TOTP_ISSUER=Titanic Gym
# Generate a private 32-byte raw, hex, or base64 key before MFA setup.
TOTP_ENCRYPTION_KEY=
# Service-account JSON for member Google sign-in. Leave empty to hide it.
FIREBASE_CREDENTIALS_FILE=
SMS_NET_BD_API_KEY=
SMS_NET_BD_SENDER_ID=
# Required for hosted checkout and for SDK confirm/query (same store as the mobile app).
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWD=
SSLCOMMERZ_SANDBOX=true
# Device check-in / bridge worker key (X-Device-Key). Must match zkteco-bridge.
ATTENDANCE_DEVICE_KEY=local-attendance-device-key
# Bridge worker must heartbeat within this many seconds for device ops.
BRIDGE_HEARTBEAT_STALE_SEC=90
# Fingerprint vault encryption (32-byte hex/base64/raw). Falls back to TOTP_ENCRYPTION_KEY if empty.
BIOMETRIC_ENCRYPTION_KEY=
# Exact proxy IPs allowed to supply X-Forwarded-For; empty ignores that header.
TRUSTED_PROXY_IPS=
